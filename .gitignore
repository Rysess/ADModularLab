# Lab workspaces: only each lab's definition belongs in version control.
# Everything else under labs/<name>/ (state, secrets, inventory, VPN profiles,
# logs, credentials) is generated and sensitive.
labs/*
!labs/*/
labs/*/*
!labs/*/lab.yml
labs/.global.lock

# Terraform working files. The provider lock file is deliberately tracked.
*.tfstate
*.tfstate.*
.terraform/
crash.log
terraform/*.zip

# Credentials and keys
*.pem
lab_credentials.txt

# Left behind by the pre-./lab layout
ansible/inventory.yml
ansible/client1.ovpn
ansible/group_vars/all/lab_secrets.yml
ansible/group_vars/all/lab_facts.yml
ansible/host_vars/
ansible/*.retry

venv/
__pycache__/
*.pyc
