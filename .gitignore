# Terraform state and working files. The provider lock file is deliberately
# not ignored: it belongs in version control.
*.tfstate
*.tfstate.*
.terraform/
crash.log

# Credentials and keys
*.pem
lab_credentials.txt

# Generated by terraform apply / the vpn module
ansible/inventory.yml
ansible/client1.ovpn
ansible/group_vars/all/lab_secrets.yml
ansible/group_vars/all/lab_facts.yml
ansible/host_vars/
ansible/*.retry

venv/
__pycache__/
*.pyc

# Built by terraform from lambda/
terraform/*.zip
